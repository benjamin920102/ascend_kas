#include <iostream>
#include "kernel_tiling/kernel_tiling.h"
#include "tiling/platform/platform_ascendc.h"
#include "tiling/tiling_api.h"
#include "acl/acl.h"
#include "kernel_operator.h"
#define ASCENDC_CUBE_ONLY
#include "lib/matmul_intf.h"

#ifndef ASCEND_KAS_BATCH
#define ASCEND_KAS_BATCH 4096
#endif
#ifndef ASCEND_KAS_CUBE_GRID
#define ASCEND_KAS_CUBE_GRID 20
#endif
#ifndef ASCEND_KAS_CUBE_SINGLE_N
#define ASCEND_KAS_CUBE_SINGLE_N 224
#endif

constexpr int32_t KAS_M = 64;
constexpr int32_t KAS_N = ASCEND_KAS_BATCH;
constexpr int32_t KAS_K = 64;
constexpr int32_t KAS_FALLBACK_SINGLE_N = 256;
static_assert(ASCEND_KAS_CUBE_GRID > 0, "ASCEND_KAS_CUBE_GRID must be positive");
static_assert(ASCEND_KAS_CUBE_SINGLE_N > 0, "ASCEND_KAS_CUBE_SINGLE_N must be positive");
static_assert((ASCEND_KAS_CUBE_SINGLE_N % 32) == 0,
              "INT8 cube singleCoreN must be a multiple of 32");

__aicore__ inline int32_t KasCeilDiv(int32_t a, int32_t b) { return (a + b - 1) / b; }

__global__ __cube__ void ascend_kas_gemm_kernel(
    __gm__ int8_t* matrix,
    __gm__ int8_t* nibbles,
    __gm__ int32_t* sums,
    __gm__ uint8_t* workspace,
    AscendC::tiling::TCubeTiling tiling)
{
    const int32_t block = AscendC::GetBlockIdx();
    const int32_t mBlocks = KasCeilDiv((int32_t)tiling.M, (int32_t)tiling.singleCoreM);
    const int32_t nBlocks = KasCeilDiv((int32_t)tiling.N, (int32_t)tiling.singleCoreN);
    if (block >= mBlocks * nBlocks) return;

    const int32_t mCore = block % mBlocks;
    const int32_t nCore = block / mBlocks;
    const int32_t offsetA = mCore * (int32_t)tiling.Ka * (int32_t)tiling.singleCoreM;
    const int32_t offsetB = nCore * (int32_t)tiling.singleCoreN;
    const int32_t offsetC = mCore * (int32_t)tiling.N * (int32_t)tiling.singleCoreM
                          + nCore * (int32_t)tiling.singleCoreN;
    int32_t tailM = (int32_t)tiling.M - mCore * (int32_t)tiling.singleCoreM;
    int32_t tailN = (int32_t)tiling.N - nCore * (int32_t)tiling.singleCoreN;
    if (tailM > (int32_t)tiling.singleCoreM) tailM = (int32_t)tiling.singleCoreM;
    if (tailN > (int32_t)tiling.singleCoreN) tailN = (int32_t)tiling.singleCoreN;

    AscendC::TPipe pipe;
    AscendC::GlobalTensor<int8_t> aGM, bGM;
    AscendC::GlobalTensor<int32_t> cGM;
    aGM.SetGlobalBuffer(matrix, KAS_M * KAS_K);
    bGM.SetGlobalBuffer(nibbles, (uint64_t)KAS_K * KAS_N);
    cGM.SetGlobalBuffer(sums, (uint64_t)KAS_M * KAS_N);

    matmul::Matmul<
        matmul::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, int8_t, false>,
        matmul::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, int8_t, false>,
        matmul::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, int32_t>> mm;
    REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), mm, &tiling);
    mm.SetOrgShape(KAS_M, KAS_N, KAS_K);
    mm.SetTensorA(aGM[offsetA], false);
    mm.SetTensorB(bGM[offsetB], false);
    mm.SetTail(tailM, tailN);
    mm.IterateAll(cGM[offsetC]);
    mm.End();
}

extern "C" void LaunchKasPre(void*, void*, void*,
                              uint32_t, uint32_t, uint32_t, uint32_t, uint32_t, uint32_t,
                              void*);
extern "C" void LaunchKasPost(void*, void*, void*, void*, void*);

static bool TryGenKasTiling(platform_ascendc::PlatformAscendC* plat,
                            int32_t singleN,
                            AscendC::tiling::TCubeTiling* out)
{
    matmul_tiling::MultiCoreMatmulTiling api(*plat);
    api.SetDim(ASCEND_KAS_CUBE_GRID);
    api.SetAType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                 matmul_tiling::DataType::DT_INT8, false);
    api.SetBType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                 matmul_tiling::DataType::DT_INT8, false);
    api.SetCType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                 matmul_tiling::DataType::DT_INT32);
    api.SetOrgShape(KAS_M, KAS_N, KAS_K);
    api.SetShape(KAS_M, KAS_N, KAS_K);

    // 4096 / 20 ~= 205. 224 is the next 32-element INT8-aligned N
    // split, so the default layout uses 19 of 20 cube cores instead of the
    // original 16 of 20. Explicit single-core shape also makes the launch
    // geometry deterministic. baseK=-1 lets the tiler choose the supported K
    // split while preserving the exact INT8 x INT8 -> INT32 accumulation.
    if (api.SetSingleShape(KAS_M, singleN, KAS_K) == -1) return false;
    if (api.SetFixSplit(KAS_M, singleN, -1) == -1) return false;
    api.EnableBias(false);
    api.SetBufferSpace(-1, -1, -1);
    return api.GetTiling(*out) != -1;
}

static bool GenKasTiling(platform_ascendc::PlatformAscendC* plat,
                         AscendC::tiling::TCubeTiling* out)
{
    if (TryGenKasTiling(plat, ASCEND_KAS_CUBE_SINGLE_N, out)) return true;

    // Keep a compatibility fallback for CANN versions/devices that reject the
    // preferred split. 256 is the original project setting.
    if (ASCEND_KAS_CUBE_SINGLE_N != KAS_FALLBACK_SINGLE_N &&
        TryGenKasTiling(plat, KAS_FALLBACK_SINGLE_N, out)) {
        std::cout << "[ascend_kas] preferred cube singleN="
                  << ASCEND_KAS_CUBE_SINGLE_N
                  << " rejected; falling back to " << KAS_FALLBACK_SINGLE_N
                  << std::endl;
        return true;
    }

    std::cout << "[ascend_kas] Matmul tiling failed" << std::endl;
    return false;
}

static int g_dev = -1;
static bool g_initialized = false;
static aclrtStream g_stream = nullptr;
static AscendC::tiling::TCubeTiling g_tiling;
static uint8_t* g_workspace = nullptr;
static uint32_t* g_initial_state = nullptr;
static int8_t* g_matrix = nullptr;
static uint32_t* g_target = nullptr;
static uint8_t* g_first_hash = nullptr;
static int8_t* g_nibbles = nullptr;
static int32_t* g_sums = nullptr;
static uint32_t* g_hit = nullptr;
static uint32_t* g_hit_host = nullptr;
static uint32_t g_cube_blocks = 0;

static int KasMalloc(void** p, size_t n)
{
    aclError e = aclrtMalloc(p, n, ACL_MEM_MALLOC_HUGE_FIRST);
    return e == ACL_SUCCESS ? 0 : (int)e;
}

extern "C" int ascend_kas_init(int device_id)
{
    if (g_initialized) return 0;
    aclError e = aclInit(nullptr);
    if (e != ACL_SUCCESS && e != ACL_ERROR_REPEAT_INITIALIZE) return (int)e;
    e = aclrtSetDevice(device_id);
    if (e != ACL_SUCCESS) return (int)e;
    g_dev = device_id;
    e = aclrtCreateStream(&g_stream);
    if (e != ACL_SUCCESS) return (int)e;

    auto plat = platform_ascendc::PlatformAscendCManager::GetInstance();
    if (!GenKasTiling(plat, &g_tiling)) return -2;
    const size_t wsSize = (size_t)plat->GetLibApiWorkSpaceSize();

    if (g_tiling.singleCoreM == 0 || g_tiling.singleCoreN == 0) {
        std::cout << "[ascend_kas] tiler returned a zero single-core shape" << std::endl;
        return -3;
    }
    const int32_t mBlocks = (KAS_M + (int32_t)g_tiling.singleCoreM - 1) / (int32_t)g_tiling.singleCoreM;
    const int32_t nBlocks = (KAS_N + (int32_t)g_tiling.singleCoreN - 1) / (int32_t)g_tiling.singleCoreN;
    const int32_t totalBlocks = mBlocks * nBlocks;
    if (totalBlocks <= 0 || totalBlocks > ASCEND_KAS_CUBE_GRID) {
        std::cout << "[ascend_kas] invalid cube tiling: singleM="
                  << g_tiling.singleCoreM << " singleN=" << g_tiling.singleCoreN
                  << " requires " << totalBlocks << " blocks, grid="
                  << ASCEND_KAS_CUBE_GRID << std::endl;
        return -3;
    }
    g_cube_blocks = (uint32_t)totalBlocks;

    int rc = 0;
    if ((rc = KasMalloc((void**)&g_workspace, wsSize)) != 0) return rc;
    if ((rc = KasMalloc((void**)&g_initial_state, 25 * sizeof(uint64_t))) != 0) return rc;
    if ((rc = KasMalloc((void**)&g_matrix, 64 * 64 * sizeof(int8_t))) != 0) return rc;
    if ((rc = KasMalloc((void**)&g_target, 4 * sizeof(uint64_t))) != 0) return rc;
    if ((rc = KasMalloc((void**)&g_first_hash, (size_t)ASCEND_KAS_BATCH * 32)) != 0) return rc;
    if ((rc = KasMalloc((void**)&g_nibbles, (size_t)64 * ASCEND_KAS_BATCH)) != 0) return rc;
    if ((rc = KasMalloc((void**)&g_sums, (size_t)64 * ASCEND_KAS_BATCH * sizeof(int32_t))) != 0) return rc;
    if ((rc = KasMalloc((void**)&g_hit, 2 * sizeof(uint32_t))) != 0) return rc;
    e = aclrtMallocHost((void**)&g_hit_host, 2 * sizeof(uint32_t));
    if (e != ACL_SUCCESS) return (int)e;

    g_initialized = true;
    std::cout << "[ascend_kas] init device=" << device_id
              << " batch=" << ASCEND_KAS_BATCH
              << " cube_grid=" << ASCEND_KAS_CUBE_GRID
              << " cube_active=" << g_cube_blocks
              << " cube_single_n=" << g_tiling.singleCoreN
              << " workspace=" << wsSize << std::endl;
    return 0;
}

extern "C" int ascend_kas_set_job(const uint64_t initial_state[25], const int8_t matrix[4096], const uint64_t target[4])
{
    if (!g_initialized || !initial_state || !matrix || !target) return -1;
    // The Rust miner owns this runtime from one dedicated host thread; the
    // device was selected once in ascend_kas_init, so avoid aclrtSetDevice on
    // every job/scan hot-path call.
    aclError e = aclrtMemcpy(g_initial_state, 25 * sizeof(uint64_t), initial_state, 25 * sizeof(uint64_t),
                             ACL_MEMCPY_HOST_TO_DEVICE);
    if (e != ACL_SUCCESS) return (int)e;
    e = aclrtMemcpy(g_matrix, 4096, matrix, 4096, ACL_MEMCPY_HOST_TO_DEVICE);
    if (e != ACL_SUCCESS) return (int)e;
    e = aclrtMemcpy(g_target, 4 * sizeof(uint64_t), target, 4 * sizeof(uint64_t), ACL_MEMCPY_HOST_TO_DEVICE);
    return e == ACL_SUCCESS ? 0 : (int)e;
}

extern "C" int ascend_kas_scan(uint64_t nonce_base, uint64_t nonce_mask, uint64_t nonce_fixed,
                                uint64_t* found_nonce, uint64_t* hashes_done)
{
    if (!g_initialized || !found_nonce || !hashes_done) return -1;
    *hashes_done = 0;
    *found_nonce = 0;

    const uint32_t baseLo = (uint32_t)nonce_base;
    const uint32_t baseHi = (uint32_t)(nonce_base >> 32);
    const uint32_t maskLo = (uint32_t)nonce_mask;
    const uint32_t maskHi = (uint32_t)(nonce_mask >> 32);
    const uint32_t fixedLo = (uint32_t)nonce_fixed;
    const uint32_t fixedHi = (uint32_t)(nonce_fixed >> 32);

    aclError e = aclrtMemsetAsync(g_hit, 2 * sizeof(uint32_t), 0, 2 * sizeof(uint32_t), g_stream);
    if (e != ACL_SUCCESS) return (int)e;

    LaunchKasPre(g_initial_state, g_first_hash, g_nibbles,
                 baseLo, baseHi, maskLo, maskHi, fixedLo, fixedHi, g_stream);

    ascend_kas_gemm_kernel<<<g_cube_blocks, nullptr, g_stream>>>(
        g_matrix, g_nibbles, g_sums, g_workspace, g_tiling);

    LaunchKasPost(g_sums, g_first_hash, g_target, g_hit, g_stream);
    e = aclrtMemcpyAsync(g_hit_host, 2 * sizeof(uint32_t), g_hit, 2 * sizeof(uint32_t),
                         ACL_MEMCPY_DEVICE_TO_HOST, g_stream);
    if (e != ACL_SUCCESS) return (int)e;
    e = aclrtSynchronizeStream(g_stream);
    if (e != ACL_SUCCESS) return (int)e;

    *hashes_done = ASCEND_KAS_BATCH;
    if (g_hit_host[1] == 1u && g_hit_host[0] < ASCEND_KAS_BATCH) {
        uint64_t counter = nonce_base + (uint64_t)g_hit_host[0];
        *found_nonce = (counter & nonce_mask) | nonce_fixed;
        return 1;
    }
    return 0;
}

extern "C" uint32_t ascend_kas_workload(void) { return ASCEND_KAS_BATCH; }

extern "C" void ascend_kas_finalize(void)
{
    if (g_dev >= 0) aclrtSetDevice(g_dev);
    if (g_initial_state) { aclrtFree(g_initial_state); g_initial_state = nullptr; }
    if (g_matrix) { aclrtFree(g_matrix); g_matrix = nullptr; }
    if (g_target) { aclrtFree(g_target); g_target = nullptr; }
    if (g_first_hash) { aclrtFree(g_first_hash); g_first_hash = nullptr; }
    if (g_nibbles) { aclrtFree(g_nibbles); g_nibbles = nullptr; }
    if (g_sums) { aclrtFree(g_sums); g_sums = nullptr; }
    if (g_hit) { aclrtFree(g_hit); g_hit = nullptr; }
    if (g_hit_host) { aclrtFreeHost(g_hit_host); g_hit_host = nullptr; }
    if (g_workspace) { aclrtFree(g_workspace); g_workspace = nullptr; }
    if (g_stream) { aclrtDestroyStream(g_stream); g_stream = nullptr; }
    if (g_dev >= 0) aclrtResetDevice(g_dev);
    g_cube_blocks = 0;
    g_dev = -1;
    g_initialized = false;
}
