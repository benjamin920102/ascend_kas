#include "kernel_operator.h"

#ifndef ASCEND_KAS_BATCH
#define ASCEND_KAS_BATCH 4096
#endif
#ifndef ASCEND_KAS_VEC_GRID
#define ASCEND_KAS_VEC_GRID 40
#endif

static_assert(ASCEND_KAS_VEC_GRID > 0, "ASCEND_KAS_VEC_GRID must be positive");
static_assert(ASCEND_KAS_BATCH > 0, "ASCEND_KAS_BATCH must be positive");

struct KasU64 { uint32_t lo; uint32_t hi; };

__aicore__ inline KasU64 kas_xor64(KasU64 a, KasU64 b) { KasU64 r = {a.lo ^ b.lo, a.hi ^ b.hi}; return r; }
__aicore__ inline KasU64 kas_and64(KasU64 a, KasU64 b) { KasU64 r = {a.lo & b.lo, a.hi & b.hi}; return r; }
__aicore__ inline KasU64 kas_not64(KasU64 a) { KasU64 r = {~a.lo, ~a.hi}; return r; }

__aicore__ inline KasU64 kas_rotl64(KasU64 x, int32_t s) {
    KasU64 r;
    if (s == 0) return x;
    if (s < 32) {
        r.lo = (x.lo << s) | (x.hi >> (32 - s));
        r.hi = (x.hi << s) | (x.lo >> (32 - s));
    } else if (s == 32) {
        r.lo = x.hi; r.hi = x.lo;
    } else {
        int32_t t = s - 32;
        r.lo = (x.hi << t) | (x.lo >> (32 - t));
        r.hi = (x.lo << t) | (x.hi >> (32 - t));
    }
    return r;
}

__aicore__ inline uint8_t kas_byte(KasU64 x, int32_t idx) {
    if (idx < 4) return (uint8_t)((x.lo >> (idx * 8)) & 0xffu);
    return (uint8_t)((x.hi >> ((idx - 4) * 8)) & 0xffu);
}

__aicore__ inline uint32_t kas_pack4_le(uint8_t b0, uint8_t b1, uint8_t b2, uint8_t b3) {
    return (uint32_t)b0 | ((uint32_t)b1 << 8) | ((uint32_t)b2 << 16) | ((uint32_t)b3 << 24);
}

// Balanced contiguous nonce assignment. Compared with the original strided
// core/core+grid/core+2*grid pattern this keeps each AIV core on a contiguous
// GM range while preserving exactly the same set of nonce indices.
__aicore__ inline int32_t kas_core_begin(int32_t core) {
    const int32_t base = ASCEND_KAS_BATCH / ASCEND_KAS_VEC_GRID;
    const int32_t extra = ASCEND_KAS_BATCH % ASCEND_KAS_VEC_GRID;
    return core * base + ((core < extra) ? core : extra);
}

__aicore__ inline int32_t kas_core_end(int32_t core) {
    const int32_t base = ASCEND_KAS_BATCH / ASCEND_KAS_VEC_GRID;
    const int32_t extra = ASCEND_KAS_BATCH % ASCEND_KAS_VEC_GRID;
    return kas_core_begin(core) + base + ((core < extra) ? 1 : 0);
}

// Scalar bit-exact Keccak-f1600. This keeps the original uint32 lo/hi model,
// but removes modulo operations and the dynamic rho/pi lookup loop from every
// round. The operation order and all round constants are unchanged.
__aicore__ inline void kas_keccak_f1600(KasU64 st[25]) {
    const uint32_t rcLo[24] = {
        0x00000001u, 0x00008082u, 0x0000808au, 0x80008000u,
        0x0000808bu, 0x80000001u, 0x80008081u, 0x00008009u,
        0x0000008au, 0x00000088u, 0x80008009u, 0x8000000au,
        0x8000808bu, 0x0000008bu, 0x00008089u, 0x00008003u,
        0x00008002u, 0x00000080u, 0x0000800au, 0x8000000au,
        0x80008081u, 0x00008080u, 0x80000001u, 0x80008008u
    };
    const uint32_t rcHi[24] = {
        0x00000000u, 0x00000000u, 0x80000000u, 0x80000000u,
        0x00000000u, 0x00000000u, 0x80000000u, 0x80000000u,
        0x00000000u, 0x00000000u, 0x00000000u, 0x00000000u,
        0x00000000u, 0x80000000u, 0x80000000u, 0x80000000u,
        0x80000000u, 0x80000000u, 0x00000000u, 0x80000000u,
        0x80000000u, 0x80000000u, 0x00000000u, 0x80000000u
    };

    for (int32_t rnd = 0; rnd < 24; ++rnd) {
        // theta -- explicit columns remove all (i +/- k) % 5 operations.
        const KasU64 bc0 = kas_xor64(kas_xor64(kas_xor64(kas_xor64(st[0], st[5]), st[10]), st[15]), st[20]);
        const KasU64 bc1 = kas_xor64(kas_xor64(kas_xor64(kas_xor64(st[1], st[6]), st[11]), st[16]), st[21]);
        const KasU64 bc2 = kas_xor64(kas_xor64(kas_xor64(kas_xor64(st[2], st[7]), st[12]), st[17]), st[22]);
        const KasU64 bc3 = kas_xor64(kas_xor64(kas_xor64(kas_xor64(st[3], st[8]), st[13]), st[18]), st[23]);
        const KasU64 bc4 = kas_xor64(kas_xor64(kas_xor64(kas_xor64(st[4], st[9]), st[14]), st[19]), st[24]);
        const KasU64 d0 = kas_xor64(bc4, kas_rotl64(bc1, 1));
        const KasU64 d1 = kas_xor64(bc0, kas_rotl64(bc2, 1));
        const KasU64 d2 = kas_xor64(bc1, kas_rotl64(bc3, 1));
        const KasU64 d3 = kas_xor64(bc2, kas_rotl64(bc4, 1));
        const KasU64 d4 = kas_xor64(bc3, kas_rotl64(bc0, 1));
        for (int32_t j = 0; j < 25; j += 5) {
            st[j]     = kas_xor64(st[j],     d0);
            st[j + 1] = kas_xor64(st[j + 1], d1);
            st[j + 2] = kas_xor64(st[j + 2], d2);
            st[j + 3] = kas_xor64(st[j + 3], d3);
            st[j + 4] = kas_xor64(st[j + 4], d4);
        }

        // rho + pi -- fixed Keccak permutation, fully unrolled to eliminate
        // two local lookup arrays and indirect st[j] addressing.
        KasU64 t = st[1];
        KasU64 tmp;
#define KAS_RHOPI(J, R) do { tmp = st[J]; st[J] = kas_rotl64(t, R); t = tmp; } while (0)
        KAS_RHOPI(10, 1);
        KAS_RHOPI(7, 3);
        KAS_RHOPI(11, 6);
        KAS_RHOPI(17, 10);
        KAS_RHOPI(18, 15);
        KAS_RHOPI(3, 21);
        KAS_RHOPI(5, 28);
        KAS_RHOPI(16, 36);
        KAS_RHOPI(8, 45);
        KAS_RHOPI(21, 55);
        KAS_RHOPI(24, 2);
        KAS_RHOPI(4, 14);
        KAS_RHOPI(15, 27);
        KAS_RHOPI(23, 41);
        KAS_RHOPI(19, 56);
        KAS_RHOPI(13, 8);
        KAS_RHOPI(12, 25);
        KAS_RHOPI(2, 43);
        KAS_RHOPI(20, 62);
        KAS_RHOPI(14, 18);
        KAS_RHOPI(22, 39);
        KAS_RHOPI(9, 61);
        KAS_RHOPI(6, 20);
        KAS_RHOPI(1, 44);
#undef KAS_RHOPI

        // chi -- explicit row expressions remove modulo operations.
        for (int32_t j = 0; j < 25; j += 5) {
            const KasU64 a0 = st[j];
            const KasU64 a1 = st[j + 1];
            const KasU64 a2 = st[j + 2];
            const KasU64 a3 = st[j + 3];
            const KasU64 a4 = st[j + 4];
            st[j]     = kas_xor64(a0, kas_and64(kas_not64(a1), a2));
            st[j + 1] = kas_xor64(a1, kas_and64(kas_not64(a2), a3));
            st[j + 2] = kas_xor64(a2, kas_and64(kas_not64(a3), a4));
            st[j + 3] = kas_xor64(a3, kas_and64(kas_not64(a4), a0));
            st[j + 4] = kas_xor64(a4, kas_and64(kas_not64(a0), a1));
        }

        const KasU64 rc = {rcLo[rnd], rcHi[rnd]};
        st[0] = kas_xor64(st[0], rc);
    }
}

__global__ __vector__ void ascend_kas_pre_kernel(
    __gm__ uint32_t* initialState,
    __gm__ uint8_t* firstHash,
    __gm__ int8_t* nibbles,
    uint32_t nonceBaseLo, uint32_t nonceBaseHi,
    uint32_t nonceMaskLo, uint32_t nonceMaskHi,
    uint32_t nonceFixedLo, uint32_t nonceFixedHi)
{
    const int32_t core = AscendC::GetBlockIdx();
    if (core >= ASCEND_KAS_VEC_GRID) return;

    // initial_state is only 200 bytes and is identical for every nonce in the
    // batch. Pull it out of GM once per AIV core instead of once per nonce.
    KasU64 baseState[25];
    for (int32_t i = 0; i < 25; ++i) {
        baseState[i].lo = initialState[2 * i];
        baseState[i].hi = initialState[2 * i + 1];
    }

    const int32_t begin = kas_core_begin(core);
    const int32_t end = kas_core_end(core);
    for (int32_t idx = begin; idx < end; ++idx) {
        KasU64 st[25];
        for (int32_t i = 0; i < 25; ++i) st[i] = baseState[i];

        uint32_t nlo = nonceBaseLo + (uint32_t)idx;
        const uint32_t carry = (nlo < nonceBaseLo) ? 1u : 0u;
        uint32_t nhi = nonceBaseHi + carry;
        nlo = (nlo & nonceMaskLo) | nonceFixedLo;
        nhi = (nhi & nonceMaskHi) | nonceFixedHi;
        const KasU64 nonce = {nlo, nhi};
        st[9] = kas_xor64(st[9], nonce);
        kas_keccak_f1600(st);

        const uint64_t idx64 = (uint64_t)idx;
        const uint64_t hashBase = idx64 * 32;
        for (int32_t w = 0; w < 4; ++w) {
            for (int32_t b = 0; b < 8; ++b) {
                const int32_t byteIndex = w * 8 + b;
                const uint8_t v = kas_byte(st[w], b);
                firstHash[hashBase + byteIndex] = v;
                nibbles[(uint64_t)(2 * byteIndex) * ASCEND_KAS_BATCH + idx64] = (int8_t)(v >> 4);
                nibbles[(uint64_t)(2 * byteIndex + 1) * ASCEND_KAS_BATCH + idx64] = (int8_t)(v & 0x0fu);
            }
        }
    }
}

extern "C" void LaunchKasPre(void* initialState, void* firstHash, void* nibbles,
                              uint32_t nonceBaseLo, uint32_t nonceBaseHi,
                              uint32_t nonceMaskLo, uint32_t nonceMaskHi,
                              uint32_t nonceFixedLo, uint32_t nonceFixedHi,
                              void* stream)
{
    ascend_kas_pre_kernel<<<ASCEND_KAS_VEC_GRID, nullptr, stream>>>(
        (uint32_t*)initialState, (uint8_t*)firstHash, (int8_t*)nibbles,
        nonceBaseLo, nonceBaseHi, nonceMaskLo, nonceMaskHi, nonceFixedLo, nonceFixedHi);
}

__aicore__ inline int32_t kas_le_target(KasU64 st[25], const uint32_t target[8]) {
    for (int32_t i = 7; i >= 0; --i) {
        const uint32_t h = (i & 1) ? st[i >> 1].hi : st[i >> 1].lo;
        const uint32_t t = target[i];
        if (h < t) return 1;
        if (h > t) return 0;
    }
    return 1;
}

__global__ __vector__ void ascend_kas_post_kernel(
    __gm__ int32_t* sums,
    __gm__ uint8_t* firstHash,
    __gm__ uint32_t* target,
    __gm__ uint32_t* hit)
{
    const uint32_t heavyLo[25] = {0xb2248509u, 0x2f9f4216u, 0x16c7f8eeu, 0x80056498u, 0x44eecedau, 0x14f34069u, 0x938935bau, 0x250fc462u, 0x0dcf6a48u, 0x792a3d0cu, 0xd0a9a226u, 0x54c18c3fu, 0xa769cc3du, 0x562493e4u, 0x99cdb044u, 0x5434f2b0u, 0x36bc9416u, 0x7765cc07u, 0xbac46d39u, 0x7b34ca58u, 0x8481b957u, 0x5112c22eu, 0xb5290c0au, 0x2f9fc615u, 0x10b9da35u};
    const uint32_t heavyHi[25] = {0x3ad74c52u, 0x79629b0eu, 0x7a14ff48u, 0x11a75f4cu, 0xe720e0dfu, 0x72c7d82eu, 0xc100ff2au, 0x5e219040u, 0x8039f9a6u, 0xa0bcaa9fu, 0xf431c05du, 0xd31f4cc3u, 0x6c6b7d01u, 0x2ec65bd3u, 0x4ef74b3au, 0x774c8683u, 0x07e961b0u, 0x7e8f1db1u, 0xea8fdb80u, 0xb992f2d3u, 0xc776c504u, 0x47c39f67u, 0x92bb399du, 0x549ae031u, 0x1619327du};
    const int32_t core = AscendC::GetBlockIdx();
    if (core >= ASCEND_KAS_VEC_GRID) return;

    // Cache the 32-byte target and the fixed HeavyHash Keccak state once per
    // AIV core. Both values are invariant across every nonce in this kernel.
    uint32_t targetLocal[8];
    for (int32_t i = 0; i < 8; ++i) targetLocal[i] = target[i];
    KasU64 heavyBase[25];
    for (int32_t i = 0; i < 25; ++i) {
        heavyBase[i].lo = heavyLo[i];
        heavyBase[i].hi = heavyHi[i];
    }

    const int32_t begin = kas_core_begin(core);
    const int32_t end = kas_core_end(core);
    for (int32_t idx = begin; idx < end; ++idx) {
        const uint64_t idx64 = (uint64_t)idx;
        const uint64_t hashBase = idx64 * 32;
        uint8_t mixed[32];
        for (int32_t i = 0; i < 32; ++i) {
            const uint32_t s0 = (uint32_t)sums[(uint64_t)(2 * i) * ASCEND_KAS_BATCH + idx64];
            const uint32_t s1 = (uint32_t)sums[(uint64_t)(2 * i + 1) * ASCEND_KAS_BATCH + idx64];
            const uint8_t p = (uint8_t)(((s0 >> 10) << 4) | (s1 >> 10));
            mixed[i] = p ^ firstHash[hashBase + i];
        }

        KasU64 st[25];
        for (int32_t i = 0; i < 25; ++i) st[i] = heavyBase[i];
        for (int32_t w = 0; w < 4; ++w) {
            const uint32_t lo = kas_pack4_le(mixed[w*8], mixed[w*8+1], mixed[w*8+2], mixed[w*8+3]);
            const uint32_t hi = kas_pack4_le(mixed[w*8+4], mixed[w*8+5], mixed[w*8+6], mixed[w*8+7]);
            const KasU64 in = {lo, hi};
            st[w] = kas_xor64(st[w], in);
        }
        kas_keccak_f1600(st);

        if (kas_le_target(st, targetLocal)) {
            hit[0] = (uint32_t)idx;
            hit[1] = 1u;
            dcci((__gm__ uint32_t*)hit, cache_line_t::SINGLE_CACHE_LINE, dcci_dst_t::CACHELINE_OUT);
        }
    }
}

extern "C" void LaunchKasPost(void* sums, void* firstHash, void* target, void* hit, void* stream)
{
    ascend_kas_post_kernel<<<ASCEND_KAS_VEC_GRID, nullptr, stream>>>(
        (int32_t*)sums, (uint8_t*)firstHash, (uint32_t*)target, (uint32_t*)hit);
}
